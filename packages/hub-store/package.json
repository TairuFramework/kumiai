{
  "name": "@kumiai/hub-store",
  "version": "0.10.1",
  "description": "SQL hub store for Kumiai hubs, backed by Hozon",
  "keywords": [
    "hub",
    "store",
    "sql",
    "hozon"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TairuFramework/kumiai",
    "directory": "packages/hub-store"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./lib/index.js"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/*"
  ],
  "scripts": {
    "build": "pnpm run build:clean && pnpm run build:js && pnpm run build:types",
    "build:clean": "del lib",
    "build:js": "del 'lib/**/*.js' && swc src -d ./lib --config-file ../../node_modules/@kigu/dev/swc.json --strip-leading-paths",
    "build:types": "del 'lib/**/*.d.ts' 'lib/**/*.d.ts.map' && tsc --emitDeclarationOnly --skipLibCheck",
    "prepublishOnly": "pnpm run build",
    "test": "pnpm run test:types && pnpm run test:unit",
    "test:types": "tsc --noEmit --skipLibCheck -p tsconfig.test.json",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@hozon/adapter": "catalog:",
    "@hozon/db": "catalog:",
    "@kumiai/hub-protocol": "workspace:^",
    "@sozai/event": "catalog:"
  },
  "devDependencies": {
    "@enkaku/client": "catalog:",
    "@enkaku/protocol": "catalog:",
    "@enkaku/transport": "catalog:",
    "@hozon/node-sqlite": "catalog:",
    "@hozon/postgres": "catalog:",
    "@kokuin/token": "catalog:",
    "@kumiai/hub-conformance": "workspace:^",
    "@kumiai/hub-server": "workspace:^",
    "@testcontainers/postgresql": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
